{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.courier-tracking.invalid/v1/common.schema.json",
  "title": "Common definitions (v1)",
  "description": "Shared building blocks. Formats are expressed as patterns, not 'format', so every validator enforces them identically.",
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "nullableUuid": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "description": "RFC 3339, UTC only, 'Z' suffix.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    },
    "key": {
      "description": "Adapter key or provider code.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,49}$"
    },
    "trackingNumber": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,99}$"
    },
    "attempt": {
      "description": "Logical attempt number, assigned by the Engine. Starts at 1.",
      "type": "integer",
      "minimum": 1
    },
    "deliveryCount": {
      "description": "Broker redelivery count for this physical execution. 0 on first delivery.",
      "type": "integer",
      "minimum": 0
    },
    "workerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z.-]+)?$"
    },
    "outcome": {
      "enum": ["SUCCESS", "NOT_FOUND", "FAILURE"]
    },
    "workerErrorClass": {
      "description": "Error classes a worker may report. DELIVERY_LIMIT_EXCEEDED, QUEUE_WAIT_EXCEEDED, WORKER_LOST, INTERVENTION_EXPIRED and CHALLENGE_LIMIT_EXCEEDED are assigned only by the Engine and are deliberately absent.",
      "enum": [
        "NETWORK_TIMEOUT",
        "NETWORK_CONNECT",
        "HTTP_5XX",
        "RATE_LIMITED",
        "BLOCKED",
        "AUTH_INVALID",
        "AUTH_EXPIRED",
        "PARSE_ERROR",
        "SCHEMA_DRIFT",
        "ADAPTER_TIMEOUT",
        "INTERNAL",
        "UNKNOWN",
        "SESSION_LOST"
      ]
    },
    "location": {
      "type": "object",
      "properties": {
        "city": { "type": ["string", "null"], "maxLength": 200 },
        "state": { "type": ["string", "null"], "maxLength": 200 },
        "country": { "type": ["string", "null"], "maxLength": 200 },
        "postal_code": { "type": ["string", "null"], "maxLength": 50 },
        "raw": { "type": ["string", "null"], "maxLength": 500 }
      }
    },
    "trackingEvent": {
      "description": "One provider event. raw_status is the provider's own wording; normalization happens in the Engine.",
      "type": "object",
      "required": ["raw_status", "occurred_at"],
      "properties": {
        "raw_status": { "type": "string", "minLength": 1, "maxLength": 200 },
        "raw_description": { "type": ["string", "null"], "maxLength": 2000 },
        "occurred_at": { "$ref": "#/$defs/timestamp" },
        "location": { "$ref": "#/$defs/location" }
      }
    },
    "rawResponse": {
      "description": "The provider response exactly as received, kept for debugging.",
      "type": "object",
      "required": ["content_type", "body"],
      "properties": {
        "content_type": { "type": "string", "minLength": 1, "maxLength": 200 },
        "body": {}
      }
    },
    "error": {
      "type": "object",
      "required": ["class", "message", "retryable"],
      "properties": {
        "class": { "$ref": "#/$defs/workerErrorClass" },
        "message": { "type": "string", "maxLength": 2000 },
        "retryable": { "type": "boolean" },
        "retry_after_ms": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "duration_ms": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
