{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.courier-tracking.invalid/v1/job.started.schema.json",
  "title": "job.started (v1) — adapter worker to Engine",
  "description": "Announces that one physical execution of an attempt has begun. May arrive after the matching job.result, or never.",
  "allOf": [{ "$ref": "envelope.schema.json" }],
  "properties": {
    "type": { "const": "job.started" },
    "payload": {
      "type": "object",
      "required": [
        "job_id",
        "attempt",
        "execution_id",
        "delivery_count",
        "worker_id",
        "adapter_key",
        "adapter_version",
        "started_at"
      ],
      "properties": {
        "job_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "attempt": { "$ref": "common.schema.json#/$defs/attempt" },
        "execution_id": {
          "description": "Generated by the worker for each delivery it executes. Identifies one physical execution.",
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "delivery_count": { "$ref": "common.schema.json#/$defs/deliveryCount" },
        "worker_id": { "$ref": "common.schema.json#/$defs/workerId" },
        "adapter_key": { "$ref": "common.schema.json#/$defs/key" },
        "adapter_version": { "$ref": "common.schema.json#/$defs/version" },
        "started_at": { "$ref": "common.schema.json#/$defs/timestamp" }
      }
    }
  }
}
