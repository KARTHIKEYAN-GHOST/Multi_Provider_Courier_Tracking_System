# Copy to .env (make env does this). Development values only — change every password outside local development.
# Passwords must use only letters, digits, '-' and '_' (they are substituted into JSON and URLs).

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_USER=courier
POSTGRES_PASSWORD=courier_dev_password
POSTGRES_DB=courier
POSTGRES_TEST_DB=courier_test
# Host port. 5432 is deliberately avoided: many machines already run a local PostgreSQL there.
POSTGRES_HOST_PORT=55432

# --- RabbitMQ -----------------------------------------------------------------
RABBITMQ_VHOST=courier
RABBITMQ_HOST_PORT=5672
RABBITMQ_MGMT_HOST_PORT=15672

# Operator account for the management UI (http://localhost:15672).
RABBITMQ_ADMIN_USER=courier_admin
RABBITMQ_ADMIN_PASSWORD=admin_dev_password

# Engine account: full rights inside the vhost (declares topology, publishes jobs, consumes events).
RABBITMQ_ENGINE_USER=engine
RABBITMQ_ENGINE_PASSWORD=engine_dev_password

# Adapter worker account: may only consume adapter queues and publish to courier.events.
RABBITMQ_WORKER_USER=adapter_worker
RABBITMQ_WORKER_PASSWORD=worker_dev_password

# --- Redis (Phase 8) -------------------------------------------------------------
# Session store of the adapter workers (lookups waiting for a one-time code or CAPTCHA).
REDIS_PASSWORD=dev_redis_password
# Host port. 6379 is deliberately avoided: many machines already run a local Redis there.
REDIS_HOST_PORT=56379

# --- Engine --------------------------------------------------------------------
ENGINE_HTTP_ADDR=127.0.0.1:8080
# Host port of the Engine container started by `make up` (optional)
# ENGINE_HOST_PORT=8080
LOG_FORMAT=json
# Optional tuning (defaults shown):
# OUTBOX_POLL_MS=250                 how often the relay looks for unsent messages when idle
# RETRY_SCHEDULER_INTERVAL_MS=500    how often due retries are opened
# REAPER_INTERVAL_MS=1000            how often expired attempts are closed
# EVENT_PREFETCH=20                  unacknowledged worker events held at once
# MAX_DEAD_LETTER_RETRIES=1          retries allowed after a job message is dead-lettered
# POLL_SCHEDULER_INTERVAL_MS=1000    how often shipments due for a re-poll are looked for
# MAINTENANCE_INTERVAL_MS=300000     how often archiving and retention run
# RETENTION_DAYS=180                 days after archiving until a shipment's events and raw responses are deleted (0 = never)
# OUTBOX_RETENTION_DAYS=7            days a sent outbox message is kept (0 = forever)
# INBOX_RETENTION_DAYS=30            days a message-dedupe row is kept (0 = forever)


# --- Provider credentials (Phase 6) --------------------------------------------
# Master key that encrypts stored provider credentials: 64 hexadecimal characters.
# Create one with:  make master-key   and paste it here. Keep it out of version control
# and back it up: without it the stored credentials cannot be read.
# Empty = no credential store; providers that need a credential (dhl) stay unavailable.
CREDENTIAL_MASTER_KEY=
# CREDENTIAL_KEY_VERSION=1
# Internal API for adapter workers (credential resolve). Host-side runs only; in Compose it
# is fixed to port 8081 inside the stack and never published.
# ENGINE_INTERNAL_ADDR=127.0.0.1:8081
# false = the test providers (dummy, demosite) are switched off at Engine start-up. Use false in production.
ENABLE_DUMMY_PROVIDER=true

# --- Human intervention: one-time codes and CAPTCHAs (Phase 8) -------------------
# The Engine stores a user's answer encrypted with CREDENTIAL_MASTER_KEY (above), so that key
# must be set for the workflow to work.
# Key that encrypts sessions in Redis: 64 hexadecimal characters. Create one with:
#   make session-key
WORKER_SESSION_KEY=
# Session store as seen from the host (workers started with `make run-worker` and the tests):
# WORKER_SESSION_STORE_URL=redis://:dev_redis_password@127.0.0.1:56379/0
# Token of the demo-site worker, for fetching answers from the Engine. Printed once by:
#   courier-engine admin create-worker-token --adapter demosite
# DEMOSITE_WORKER_TOKEN=
# The human interface (http://localhost:8088 after `make up`):
# HUMAN_INTERFACE_HOST_PORT=8088
# HUMAN_INTERFACE_ENGINE_URL=http://127.0.0.1:8080   # host-side runs (make run-human-interface)
# HUMAN_INTERFACE_COOKIE_SECURE=false                # true wherever the page is served over HTTPS
# DEMO_SITE_HOST_PORT=8090

# --- DHL adapter (optional; make up-dhl) ---------------------------------------
# Token printed once by: courier-engine admin create-worker-token --adapter dhl
# The DHL API key itself is NOT configured here: store it with `admin set-credential`.
# DHL_WORKER_TOKEN=
# DHL_BASE_URL=https://api-eu.dhl.com
# DHL_WORKER_CONCURRENCY=2

# --- Connection strings used by host-side tools and tests -----------------------
DATABASE_URL=postgres://courier:courier_dev_password@localhost:55432/courier
ENGINE_AMQP_URL=amqp://engine:engine_dev_password@localhost:5672/courier
WORKER_AMQP_URL=amqp://adapter_worker:worker_dev_password@localhost:5672/courier

# Adapter worker tuning (optional; defaults shown)
# WORKER_CONCURRENCY=4            # jobs running at the same time in one worker process
# WORKER_PREFETCH=4               # unacknowledged messages RabbitMQ hands over (default = concurrency)
# WORKER_SHUTDOWN_GRACE_S=30      # on SIGTERM: time for running jobs to finish
# WORKER_CLEANUP_TIMEOUT_S=5      # upper bound for one job's resource cleanup
# WORKER_EXPIRY_SKEW_S=5          # tolerated clock difference when dropping expired jobs
# WORKER_ENGINE_INTERNAL_URL=http://127.0.0.1:8081   # Engine internal API (adapters using credentials)
# WORKER_TOKEN=                   # this worker's token for it (secret)
# DEMOSITE_BASE_URL=http://127.0.0.1:8090   # where the demo-site adapter finds the demo courier website
# WORKER_SESSION_TTL_S=4500       # longest time a saved session is kept
# WORKER_RESUME_LEASE_MARGIN_S=60 # a resume lease lasts the job's timeout plus this (publish + acknowledge)
# WORKER_RESUME_LEASE_POLL_S=0.25 # how often a worker that found the lease taken looks again
# WORKER_ALLOW_FAULT_INJECTION=false   # test environments only: lets DUMMY-CRASH/HANG/DUP act

# --- Indian couriers (optional; make up-couriers; docs/indian-couriers.md) -----
# Tokens printed once by: courier-engine admin create-worker-token --adapter <delhivery|safexpress>
# The couriers' own secrets are NOT configured here: store them with `admin set-credential`.
# DELHIVERY_WORKER_TOKEN=
# SAFEXPRESS_WORKER_TOKEN=
# DELHIVERY_BASE_URL=https://track.delhivery.com   # test system: https://staging-express.delhivery.com
# SAFEXPRESS_TOKEN_URL=                            # only if Safexpress's API document names other addresses
# SAFEXPRESS_TRACKING_URL=
# SAFEXPRESS_SCOPE=

# ---------------------------------------------------------------- AI repair service (Phase 9)
# See docs/phase-9.md and docs/phase-11.md. The secrets below belong in .env only, never in Git.
#
# Shared by the Engine and the repair service (make repair-token). Empty = the Engine
# hands out no repair tasks.
# ENGINE_REPAIR_TOKEN=
# OpenRouter: the API key, and the model that writes the code (a name from openrouter.ai/models).
# One name, or up to three separated by commas (first choice, then fallbacks). Without it the
# free models that did best in docs/phase-9.md are used.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=baidu/ernie-5.5-flash-preview:free,particle-ai/particle-1:free,openrouter/free
# Who supplies the model (Phase 11): openrouter (default), claude-code or anthropic.
#   claude-code: Claude through a Claude subscription. Run "claude setup-token" once and put
#                the token it prints here. For development on your own laptop.
#   anthropic:   Claude through an API key from platform.claude.com. For the server that
#                many organizations use.
# AI_REPAIR_MODEL_SUPPLIER=openrouter
# CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=
# AI_REPAIR_CLAUDE_MODEL=claude-opus-5-5
# AI_REPAIR_CLAUDE_EFFORT=high      # low | medium | high | xhigh | max
# The GitHub repository ("owner/name") the service clones and pushes to, and a fine-grained
# token for that one repository with "Contents: Read and write".
# AI_REPAIR_GITHUB_REPO=
# AI_REPAIR_GITHUB_TOKEN=
# AI_REPAIR_PUSH_BRANCH=main        # where finished work is pushed
# AI_REPAIR_DRY_RUN=false           # true = do everything except the push
# AI_REPAIR_AGENT_MAX_STEPS=40
# AI_REPAIR_AGENT_MAX_REQUESTS=60
# AI_REPAIR_AGENT_BROWSER=true
# AI_REPAIR_POLL_S=60               # how often the Engine is asked for work
# AI_REPAIR_ENGINE_URL=http://127.0.0.1:8081
